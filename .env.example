# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ecsite
DB_USER=ecuser
DB_PASSWORD=ecpassword
DB_ROOT_PASSWORD=rootpassword

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# Cognito Configuration
# LocalStack の場合、init-aws.sh の出力から取得した値に更新してください
COGNITO_USER_POOL_ID=us-east-1_xxxxx
COGNITO_CLIENT_ID=xxxxx
COGNITO_CLIENT_SECRET=xxxxx
COGNITO_REGION=us-east-1
# JWKS URL (本番環境では自動構築されますが、LocalStackの場合は手動設定が必要な場合があります)
COGNITO_JWKS_URL=http://localhost:4566/

# Service URLs
PRODUCT_SERVICE_URL=http://product-service:8001
CART_SERVICE_URL=http://cart-service:8002
ORDER_SERVICE_URL=http://order-service:8003
POINT_SERVICE_URL=http://point-service:8004
PROMOTION_SERVICE_URL=http://promotion-service:8005

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=info
